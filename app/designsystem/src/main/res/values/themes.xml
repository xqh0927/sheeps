<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sheeps.Window" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowAnimationStyle">@style/SheepsActivityMotion</item>
    </style>
    <style name="SheepsActivityMotion" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/sheeps_push_in</item>
        <item name="android:activityOpenExitAnimation">@anim/sheeps_push_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/sheeps_pop_in</item>
        <item name="android:activityCloseExitAnimation">@anim/sheeps_pop_out</item>
    </style>

    <style name="Theme.Sheeps.SystemGlass" parent="Theme.Sheeps.Window">
        <item name="iconColor">@color/glass_accent</item>
        <item name="android:windowBackground">@color/glass_canvas</item>
    </style>
    <style name="Theme.Sheeps.Polar" parent="Theme.Sheeps.Window">
        <item name="iconColor">#76E5D5</item>
        <item name="android:windowBackground">#0B141C</item>
    </style>

    <style name="Theme.Sheeps.MoYeGold" parent="Theme.Sheeps.Window">
        <item name="iconColor">#FFCCCCCC</item>
    </style>

    <style name="Theme.Sheeps.QingRiChun" parent="Theme.Sheeps.Window">
        <item name="iconColor">#FF666666</item>
    </style>
    <!-- 四套女性向主题 -->
    <style name="Theme.Sheeps.Sakura" parent="Theme.Sheeps.Window">
        <item name="iconColor">#FFEC407A</item>
    </style>

    <style name="Theme.Sheeps.Cosmic" parent="Theme.Sheeps.Window">
        <item name="iconColor">#FF3F51B5</item>
    </style>

    <style name="Theme.Sheeps.Sunset" parent="Theme.Sheeps.Window">
        <item name="iconColor">#FFFF9800</item>
    </style>

    <style name="Theme.Sheeps.Forest" parent="Theme.Sheeps.Window">
        <item name="iconColor">#FF4CAF50</item>
    </style>
    <!-- 萌趣竞技主题 -->
    <style name="Theme.Sheeps.ShuangFun" parent="Theme.Sheeps.Window">
        <item name="iconColor">#FF29B6F6</item>
    </style>
</resources>
